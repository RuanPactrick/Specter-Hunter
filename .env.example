NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
APP_URL=http://localhost:3000

# Apenas no processo do worker. Não prefixe com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
ENABLE_GOOGLE_PLACES=false
GOOGLE_PLACES_API_KEY=
ENABLE_BRAVE_SEARCH=false
BRAVE_SEARCH_API_KEY=
# Pesquisa na web da leitura automática (preferida ao Brave quando ligada). Também no worker.
ENABLE_APIFY=false
APIFY_TOKEN=
ENABLE_OFFICIAL_PAGE_READING=false
ENABLE_ASSISTIVE_AI=false
GEMINI_API_KEY=
# opcional; se faltar ou falhar, o app tenta gemini-3.6-flash, gemini-3.8-flash, gemini-3.5-flash-lite e gemini-3.1-flash-lite
GEMINI_ASSISTIVE_MODEL=
OPENAI_API_KEY=
OPENAI_ASSISTIVE_MODEL=

# Robô na Vercel: rota /api/worker chamada pelo Vercel Cron (vercel.json). Valor aleatório e longo, só no servidor.
CRON_SECRET=
